---
layout: base.njk
permalink: /outputs/
key: outputs
pageTitle: Outputs
---
{%- import "macros.njk" as m -%}
{%- set o = db.outputs -%}
<section class="page-head wrap">
  {{ m.heading(o.title, "Results", o.standfirst, 1) }}
</section>

{%- if o.other.length %}
<section class="wrap section-tight">
  <h2 class="h-sub">{{ o.other_title }}</h2>
  <ul class="checklist" data-anim>
    {%- for d in o.other %}
    <li>{{ m.box(true) }}<div><a href="{{ d.url }}" target="_blank" rel="noopener">{{ d.title }}</a>{% if d.note %}<span class="meta">{{ d.note }}</span>{% endif %}</div>{% if d.kind %}<span class="stamp">{{ d.kind }}</span>{% endif %}</li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

<section class="wrap section-tight">
  <h2 class="h-sub">Public deliverables</h2>
  <ul class="checklist" data-anim>
    {%- for d in o.items %}
    <li{% if d.url %} class="done"{% endif %}>{{ m.box(d.url) }}
      <div>{% if d.url %}<a href="{{ d.url }}" target="_blank" rel="noopener"><b>{{ d.id }}</b> {{ d.title }}</a>{% else %}<b>{{ d.id }}</b> {{ d.title }}{% endif %}<span class="meta">{{ d.wp }} · Lead: {{ d.lead }}</span></div>
      <span class="stamp">{% if d.url %}Published{% else %}{{ d.month | projectMonth }}{% endif %}</span>
    </li>
    {%- endfor %}
  </ul>
  <p class="footnote">{{ o.note }}</p>
</section>
