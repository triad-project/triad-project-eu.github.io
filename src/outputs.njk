---
layout: base.njk
permalink: /outputs/
key: outputs
pageTitle: Outputs
---
{%- import "macros.njk" as m -%}
{%- set o = db.outputs -%}
<section class="page-head">
  <div class="wrap">
  {{ m.heading(o.title, "Results", o.standfirst, 1) }}
  </div>
  {% waves "waves" %}
</section>

{%- if o.other.length %}
<section class="wrap section-tight">
  <h2 class="h-sub">{{ o.other_title }}</h2>
  <ul class="list">
    {%- for d in o.other %}
    <li class="done"><div><a href="{{ d.url }}" target="_blank" rel="noopener">{{ d.title }}</a>{% if d.note %}<span class="meta">{{ d.note }}</span>{% endif %}</div>{% if d.kind %}<span class="tag tag-mint">{{ d.kind }}</span>{% endif %}</li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

<section class="wrap section-tight">
  <h2 class="h-sub">Public deliverables</h2>
  <ul class="list">
    {%- for d in o.items %}
    <li{% if d.url %} class="done"{% endif %}>
      <b class="num">{{ d.id }}</b>
      <div>{% if d.url %}<a href="{{ d.url }}" target="_blank" rel="noopener">{{ d.title }}</a>{% else %}{{ d.title }}{% endif %}<span class="meta">{{ d.wp }} · Lead: {{ d.lead | fullName }}</span></div>
      {% if d.url %}<span class="tag tag-mint">Published</span>{% else %}<span class="tag">{{ d.month | projectMonth }}</span>{% endif %}
    </li>
    {%- endfor %}
  </ul>
  <p class="footnote">{{ o.note }}</p>
</section>
