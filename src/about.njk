---
layout: base.njk
permalink: /about/
key: about
pageTitle: About the project
---
{%- import "macros.njk" as m -%}
{%- set a = db.about -%}
{%- set s = db.site -%}
<section class="page-head">
  <div class="wrap">
  {{ m.heading(a.title, "About", a.standfirst, 1) }}
  </div>
  {% waves "waves" %}
</section>

<section class="wrap two-col">
  <div class="prose">
    {{ a.context | paras | safe }}
  </div>
  <aside class="frame-card">
    <p class="label">The framework</p>
    <h2>{{ db.home.framework_title }}</h2>
    <ul class="areas">
      {%- for x in db.home.areas %}
      <li class="a{{ loop.index }}">{{ m.icon(x.icon) }}<div><b>{{ x.title }}</b><span>{{ x.detail }}</span></div></li>
      {%- endfor %}
      <li class="a4">{{ m.icon(db.home.center.icon) }}<div><b>{{ db.home.center.title }}</b><span>{{ db.home.center.detail }}</span></div></li>
    </ul>
  </aside>
</section>


<section class="band band-ink teeth">
  <div class="wrap">
    {{ m.heading(a.challenges_title, "01 · The questions") }}
    <ol class="rows">
      {%- for c in a.challenges %}
      <li><span class="row-icon">{{ m.icon(c.icon) }}</span><h3>{{ c.title }}</h3><p>{{ c.text }}</p></li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section wrap">
  {{ m.heading(a.approach_title, "02 · The method") }}
  <div class="prose">{{ a.approach | paras | safe }}</div>
</section>

<section class="section wrap">
  {{ m.heading(a.connect_title, "03 · The phases", a.connect_text) }}
  {%- set meta = db.workplanMeta %}
  {%- macro phase(st, n) %}
  <div class="phase p-{{ st.key }}">
    <p class="phase-top"><span class="phase-n">{{ n }}</span>{{ m.icon(st.icon) }}<span class="chip">{{ st.start | span(st.end) }}</span></p>
    <h3>{{ st.title }}</h3>
    <ul>{% for p in st.points %}<li>{{ p }}</li>{% endfor %}</ul>
  </div>
  {%- endmacro %}
  <figure class="phases" aria-label="Diagram of the four phases of TRIAD around the competence framework">
    <div class="frame frame-outer">
      <p class="frame-label">{{ m.icon(meta.frames[1].icon) }}{{ meta.frames[1].title }}</p>
      <div class="frame frame-inner">
        <p class="frame-label">{{ m.icon(meta.frames[0].icon) }}{{ meta.frames[0].title }}</p>
        <div class="phase-grid">
          {{ phase(meta.stages[0], 1) }}
          <span class="arr arr-1" aria-hidden="true">→</span>
          {{ phase(meta.stages[1], 2) }}
          <span class="arr arr-2" aria-hidden="true">↕</span>
          <div class="hub">{% include "logo.svg" %}<b>{{ meta.hub }}</b></div>
          <span class="arr arr-3" aria-hidden="true">↕</span>
          {{ phase(meta.stages[2], 3) }}
          <span class="arr arr-4" aria-hidden="true">→</span>
          {{ phase(meta.stages[3], 4) }}
        </div>
      </div>
    </div>
    <figcaption>{{ meta.source }}</figcaption>
  </figure>

  <h3 class="across-title">{{ a.wp_title }}</h3>
  <div class="table-scroll">
    <table class="wp-table">
      <thead><tr><th>Phase</th><th>Work package</th><th>Lead partner</th><th>When</th></tr></thead>
      <tbody>
        {%- for st in meta.stages.concat(meta.frames) %}
        {%- set outer = loop %}
        {%- for wp in db.workplan %}{% if wp.stage == st.key %}
        <tr class="p-{{ st.key }}"><td class="ph">{{ st.title }}</td><td><b>{{ wp.id }}</b> {{ wp.title }}</td><td class="lead-name">{{ wp.lead | fullName }}</td><td class="nowrap">{{ wp.start | span(wp.end) }}</td></tr>
        {%- endif %}{% endfor %}
        {%- endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="band band-pink">
  <div class="wrap">
    <p class="label">04 · {{ a.results_title }}</p>
    <p class="statement small">{{ a.results }}</p>
  </div>
</section>


<section class="band band-ink record-band">
  <div class="wrap">
    <p class="label">Project record</p>
    <dl>
      <div><dt>Full title</dt><dd>{{ s.full_title }}</dd></div>
      <div><dt>Grant Agreement</dt><dd>{{ s.grant }}</dd></div>
      <div><dt>Call</dt><dd>{{ s.call }}</dd></div>
      <div><dt>Topic</dt><dd>{{ s.topic }}</dd></div>
      <div><dt>Type of action</dt><dd>{{ s.action_type }}</dd></div>
      <div><dt>Duration</dt><dd>{{ s.months }} months, {{ s.start | niceDate }} to {{ s.end | niceDate }}</dd></div>
      <div><dt>Coordinator</dt><dd>{{ s.coordinator }}</dd></div>
      <div><dt>Granting authority</dt><dd>{{ s.funder }}</dd></div>
    </dl>
  </div>
</section>
