---
layout: base.njk
permalink: /about/
key: about
pageTitle: About the project
---
{%- import "macros.njk" as m -%}
{%- set a = db.about -%}
{%- set s = db.site -%}
<section class="page-head wrap">
  {{ m.heading(a.title, "About", a.standfirst, 1) }}
</section>

<section class="wrap two-col">
  <div class="prose">
    {{ a.context | paras | safe }}
  </div>
  <aside class="record">
    <p class="label">Project record</p>
    <dl>
      <div><dt>Full title</dt><dd>{{ s.full_title }}</dd></div>
      <div><dt>Grant Agreement</dt><dd>{{ s.grant }}</dd></div>
      <div><dt>Call</dt><dd>{{ s.call }}</dd></div>
      <div><dt>Topic</dt><dd>{{ s.topic }}</dd></div>
      <div><dt>Type of action</dt><dd>{{ s.action_type }}</dd></div>
      <div><dt>Duration</dt><dd>{{ s.months }} months, {{ s.start | niceDate }} to {{ s.end | niceDate }}</dd></div>
      <div><dt>Coordinator</dt><dd>{{ s.coordinator }}</dd></div>
      <div><dt>Granting authority</dt><dd>{{ s.funder }}</dd></div>
    </dl>
  </aside>
</section>

<section class="band band-ink teeth">
  <div class="wrap">
    {{ m.heading(a.challenges_title, "01 ▲ The problem") }}
    <ol class="rows">
      {%- for c in a.challenges %}
      <li><h3>{{ c.title }}</h3><p>{{ c.text }}</p></li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section wrap">
  {{ m.heading(a.approach_title, "02 ▲ The method") }}
  <div class="prose">{{ a.approach | paras | safe }}</div>
  <ol class="steps">
    {%- for p in a.path %}
    <li><p class="label">{{ p.months }}</p><h3>{{ p.title }}</h3><p>{{ p.text }}</p></li>
    {%- endfor %}
  </ol>
</section>

<section class="band band-pink">
  <div class="wrap">
    <p class="label">03 ▲ {{ a.results_title }}</p>
    <p class="statement small">{{ a.results }}</p>
  </div>
</section>

<section class="section wrap">
  {{ m.heading(a.workplan_title, "04 ▲ The work plan") }}
  <div class="timeline" data-anim>
    <div class="tl-row tl-head" aria-hidden="true">
      <span></span>
      <div class="tl-ticks">
        {%- for t in [1, 6, 12, 18, 24, 30, 36] %}
        <span style="left: {{ (t if t > 1 else 0) | pct }}%"{% if loop.first %} class="first"{% elif loop.last %} class="last"{% endif %}>M{{ t }}</span>
        {%- endfor %}
      </div>
    </div>
    {%- for wp in db.workplan %}
    <div class="tl-row">
      <div class="tl-label">
        <b>{{ wp.id }}</b> {{ wp.title }}
        <span class="label">Lead: {{ wp.lead }} ▲ M{{ wp.start }}-M{{ wp.end }}</span>
      </div>
      <div class="tl-track" aria-hidden="true"><span class="tl-bar c{{ loop.index0 % 3 }}" style="--i: {{ loop.index0 }}; left: {{ (wp.start - 1) | pct }}%; width: {{ (wp.end - wp.start + 1) | pct }}%"></span></div>
    </div>
    {%- endfor %}
  </div>
  <p class="footnote">{{ a.workplan_note }}</p>
</section>
