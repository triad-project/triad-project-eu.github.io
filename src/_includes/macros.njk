{# A numbered section heading, like an exercise in a workbook. #}
{% macro heading(title, label, standfirst, level) %}
<header class="head">
  {% if label %}<p class="label">{{ label }}</p>{% endif %}
  {% if level == 1 %}<h1>{{ title }}</h1>{% else %}<h2>{{ title }}</h2>{% endif %}
  {% if standfirst %}<p class="standfirst">{{ standfirst }}</p>{% endif %}
</header>
{% endmacro %}

{% macro newsCard(item, types) %}
<article class="note">
  <p class="stamp">{{ item.date | stamp }}{% if types[item.type] %} · {{ types[item.type] }}{% endif %}</p>
  {% if item.image %}<a class="note-img" href="/news/{{ item.slug }}/" tabindex="-1" aria-hidden="true"><img src="{{ item.image }}" alt="" loading="lazy" /></a>{% endif %}
  <h3><a href="/news/{{ item.slug }}/">{{ item.title }}</a></h3>
  {% if item.summary %}<p>{{ item.summary }}</p>{% endif %}
  {% if item.draft %}<p class="hand draft">Draft, not published</p>{% endif %}
</article>
{% endmacro %}

{# A tick or an empty box, drawn in pen. #}
{% macro box(done) %}<svg class="box{% if done %} done{% endif %}" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="16" height="16" rx="1.5"/>{% if done %}<path pathLength="1" d="M6 12 L11 17 L22 3"/>{% endif %}</svg>{% endmacro %}
