{% macro heading(title, label, standfirst, level) %}
<header class="head">
  {% if label %}<p class="label">{{ label }}</p>{% endif %}
  {% if level == 1 %}<h1>{{ title }}</h1>{% else %}<h2>{{ title }}</h2>{% endif %}
  {% if standfirst %}<p class="standfirst">{{ standfirst }}</p>{% endif %}
</header>
{% endmacro %}

{# A news card. Items without a picture get a drawn cover. `big` makes the wide lead card. #}
{% macro newsCard(item, types, big) %}
<article class="card{% if big %} card-big{% endif %}" data-tags="{{ (item.tags or []) | join('|') }}">
  <a class="card-img" href="/news/{{ item.slug }}/" tabindex="-1" aria-hidden="true">
    {% if item.image %}<img{% if item.image_tall %} class="tall"{% endif %} src="{{ item.image }}" alt="" loading="lazy" />{% else %}{% cover item.slug %}{% endif %}
    {% if types[item.type] %}<span class="chip">{{ types[item.type] }}</span>{% endif %}
  </a>
  <div class="card-body">
    <p class="label">{{ item.date | niceDate }}</p>
    <h3><a href="/news/{{ item.slug }}/">{{ item.title }}</a></h3>
    {% if item.summary %}<p>{{ item.summary }}</p>{% endif %}
    {% if item.tags and item.tags.length %}<ul class="tags">{% for t in item.tags %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
    {% if item.draft %}<p class="tag tag-draft">Draft, not published</p>{% endif %}
  </div>
</article>
{% endmacro %}

