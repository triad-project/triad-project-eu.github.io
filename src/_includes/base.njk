<!doctype html>
{%- set site = db.site %}
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{% if pageTitle %}{{ pageTitle }} | TRIAD{% else %}TRIAD: {{ db.home.headline }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}" />
<meta property="og:title" content="{{ pageTitle or site.name }}" />
<meta property="og:description" content="{{ description or site.description }}" />
<meta property="og:type" content="website" />
<meta property="og:url" content="{{ site.url }}{{ page.url }}" />
{%- if ogImage %}
<meta property="og:image" content="{{ site.url }}{{ ogImage }}" />
{%- endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/styles.css" />
<script>document.documentElement.classList.add("js");</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="TRIAD, home"><span class="plate">{% include "logo.svg" %}</span></a>
    <nav class="nav" aria-label="Main">
      {%- for n in nav %}
      <a href="{{ n.url }}"{% if key == n.key %} aria-current="page"{% endif %}>{{ n.label }}</a>
      {%- endfor %}
      <a class="nav-cta" href="/#newsletter">Newsletter</a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

{%- if key != "home" %}
<aside class="news-strip">
  <div class="wrap">
    <div><p class="label">Newsletter</p><p class="news-strip-text">{{ db.home.newsletter_text }}</p></div>
    <a class="btn btn-solid" href="/#newsletter">Sign up for the newsletter</a>
  </div>
</aside>
{%- endif %}
<footer class="site-footer">
  <div class="wrap">
    <div class="funding">
      <img src="/images/eu-emblem-horizontal-pos-tight.png" alt="Funded by the European Union" width="300" height="64" />
      <p>Funded by the European Union. Views and opinions expressed are however those of the author(s) only and do not necessarily reflect those of the European Union or the European Research Executive Agency (REA). Neither the European Union nor the granting authority can be held responsible for them. Grant Agreement No 101289995.</p>
    </div>
    <div class="footer-row">
      <nav class="footer-nav" aria-label="Footer">
        {%- for n in nav %}
        <a href="{{ n.url }}">{{ n.label }}</a>
        {%- endfor %}
      </nav>
      <div class="footer-contact">
        <a href="/privacy/">Privacy notice</a>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        {%- for s in site.social %}{% if s.url %}
        <a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a>
        {%- endif %}{% endfor %}
      </div>
    </div>
  </div>
  <div class="footer-base"><div class="wrap">triad-project.eu · Grant Agreement {{ site.grant }}</div></div>
</footer>
<script>
  // Blocks marked data-anim get the class "in" once, when they scroll into view.
  (function () {
    var els = document.querySelectorAll("[data-anim]");
    if (!("IntersectionObserver" in window)) { els.forEach(function (el) { el.classList.add("in"); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>
{%- if site.goatcounter_code %}
<script>
  // Visit counting (GoatCounter): no cookies, nothing stored in the browser. Files opened from the Outputs page are counted as downloads.
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest(".list a[href]");
    if (a && window.goatcounter && window.goatcounter.count) {
      window.goatcounter.count({ path: "download: " + a.textContent.trim().slice(0, 120), title: a.href, event: true });
    }
  });
</script>
<script data-goatcounter="https://{{ site.goatcounter_code }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{%- endif %}
</body>
</html>
