<!doctype html>
{%- set site = db.site %}
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{% if pageTitle %}{{ pageTitle }} | TRIAD{% else %}TRIAD: {{ db.home.headline }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}" />
<meta property="og:title" content="{{ pageTitle or site.name }}" />
<meta property="og:description" content="{{ description or site.description }}" />
<meta property="og:type" content="website" />
<meta property="og:url" content="{{ site.url }}{{ page.url }}" />
{%- if ogImage %}
<meta property="og:image" content="{{ site.url }}{{ ogImage }}" />
{%- endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href="/fonts/serif.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/sans.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/styles.css" />
<script>document.documentElement.classList.add("js");</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="TRIAD, home">{% include "logo.svg" %}</a>
    <nav class="nav" aria-label="Main">
      {%- for n in nav %}
      <a href="{{ n.url }}"{% if key == n.key %} aria-current="page"{% endif %}>{{ n.label }}</a>
      {%- endfor %}
      <a href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<main id="main" class="sheet">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="zigzag" aria-hidden="true"></div>
  <div class="wrap">
    <div class="funding">
      <img src="/images/eu-emblem-horizontal-pos-tight.png" alt="Funded by the European Union" width="262" height="56" />
      <p>Funded by the European Union under Grant Agreement No 101289995. Views and opinions expressed are however those of the author(s) only and do not necessarily reflect those of the European Union or the European Research Executive Agency (REA). Neither the European Union nor the granting authority can be held responsible for them.</p>
    </div>
    <div class="footer-row">
      <nav class="footer-nav" aria-label="Footer">
        {%- for n in nav %}
        <a href="{{ n.url }}">{{ n.label }}</a>
        {%- endfor %}
      </nav>
      <div class="footer-contact">
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        {%- for s in site.social %}{% if s.url %}
        <a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a>
        {%- endif %}{% endfor %}
      </div>
    </div>
    <p class="footer-base">triad-project.eu · Grant Agreement {{ site.grant }}</p>
  </div>
</footer>
<script>
  // Things drawn in pen or highlighter appear once, when they scroll into view.
  (function () {
    var els = document.querySelectorAll("[data-anim]");
    if (!("IntersectionObserver" in window)) { els.forEach(function (el) { el.classList.add("in"); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>
</body>
</html>
