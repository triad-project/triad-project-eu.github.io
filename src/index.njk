---
layout: base.njk
permalink: /
key: home
---
{%- import "macros.njk" as m -%}
{%- set h = db.home -%}
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      {% if h.eyebrow %}<p class="label">{{ h.eyebrow }}</p>{% endif %}
      <h1>{{ h.headline }}</h1>
      <p class="lead">{{ h.standfirst }}</p>
      <p class="actions">
        <a class="btn btn-solid" href="/about/">About the project</a>
        <a class="btn" href="/news/">Read the news</a>
      </p>
    </div>
    <form class="signup signup-card" id="newsletter" action="https://reach.hostinger.com/api/v1/forms/{{ db.site.reach_form_id }}/submit" method="post" data-email="{{ db.site.email }}">
      <p class="label">Newsletter</p>
      <h2>{{ h.newsletter_title }}</h2>
      <p class="signup-text">{{ h.newsletter_text }}</p>
      <input type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true" class="hp" />
      <label for="signup-email" class="label">Email address</label>
      <input id="signup-email" type="email" name="email" aria-label="Email address" placeholder="you@school.eu" autocomplete="email" required />
      <label class="consent"><input type="checkbox" name="consent" value="yes" required /><span>{{ h.newsletter_consent }} <a href="/privacy/">Privacy notice</a></span></label>
      <button class="btn btn-solid" type="submit">Sign up for the newsletter</button>
      <p class="signup-msg" role="status" hidden></p>
      <p class="signup-contact" id="contact">{{ h.contact_text }} <a href="mailto:{{ db.site.email }}">{{ db.site.email }}</a></p>
    </form>
  </div>
  {% waves "waves" %}
</section>

{%- if db.news.length %}
<section class="section wrap">
  <div class="head head-row">
    <h2>News</h2>
    <a class="more-link" href="/news/">All news →</a>
  </div>
  <div class="cards">
    {%- for item in db.news | take(3) %}
    {{ m.newsCard(item, types) }}
    {%- endfor %}
  </div>
</section>
{%- endif %}

<script>
  // Newsletter sign-up: the address goes straight into the newsletter list in Hostinger Reach,
  // in the background, so the visitor stays on the page.
  (function () {
    var form = document.getElementById("newsletter");
    if (!form) return;
    var msg = form.querySelector(".signup-msg");
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var btn = form.querySelector("button");
      // The hidden box is only ever ticked by robots: nothing is sent for them.
      if (form.botcheck.checked) return;
      btn.disabled = true;
      fetch(form.action, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: form.email.value.trim() }) })
        .then(function (r) { if (!r.ok) throw new Error(); })
        .then(function () { form.reset(); msg.textContent = "Thank you. We have sent you an email: please click the link in it to confirm."; })
        .catch(function () { msg.innerHTML = 'That did not go through. Please write to <a href="mailto:' + form.dataset.email + '">' + form.dataset.email + "</a> instead."; })
        .then(function () { msg.hidden = false; btn.disabled = false; });
    });
  })();
</script>
